<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aura radial: violeta luminoso en el centro, casi negro hacia los bordes -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="80"
                android:startColor="#A492F5"
                android:centerColor="#4A3B85"
                android:endColor="#0E0E14" />
        </aapt:attr>
    </path>

    <!-- Destello sutil arriba a la izquierda, refuerza la sensación de aura -->
    <path android:pathData="M28,30 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28"
                android:centerY="30"
                android:gradientRadius="26"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
