<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aura radial: rosa Apple Music → violeta → negro Tidal -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="96"
                android:startColor="#FF4D6D"
                android:centerColor="#7B2FF7"
                android:endColor="#000000" />
        </aapt:attr>
    </path>

    <!-- Destello sutil arriba a la izquierda, para dar profundidad -->
    <path
        android:pathData="M30,30 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="30"
                android:gradientRadius="24"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
