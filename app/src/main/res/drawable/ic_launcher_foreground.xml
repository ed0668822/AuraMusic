<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Onda sonora: 5 barras verticales de puntas redondeadas.
         Cada una es un stroke de 7dp con strokeLineCap=round, así que
         las puntas quedan perfectamente circulares sin path arcs. -->

    <!-- Barra 1 (exterior izquierda) -->
    <path
        android:pathData="M30,46 L30,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Barra 2 -->
    <path
        android:pathData="M42,40 L42,68"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Barra 3 (central, la más alta) -->
    <path
        android:pathData="M54,34 L54,74"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Barra 4 (espejo de la 2) -->
    <path
        android:pathData="M66,40 L66,68"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Barra 5 (exterior derecha) -->
    <path
        android:pathData="M78,46 L78,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

</vector>
