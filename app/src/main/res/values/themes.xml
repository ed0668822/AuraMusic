<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent AppCompat: necesario para AppCompatActivity + AppCompatDelegate.setApplicationLocales().
         DayNight para que el status bar / navigation bar hereden los colores del sistema;
         Aura pinta por encima con su propio Compose theme, así que esto solo afecta a la ventana. -->
    <style name="Theme.Aura" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ventana edge-to-edge desde el arranque -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
